      "DocumentOut": {
        "description": "A document's details. ``scan_status`` is ``clean`` once it may be downloaded.",
        "examples": [
          {
            "content_type": "application/pdf",
            "created_at": "2026-11-05T15:04:05Z",
            "file_name": "nccpa-certificate.pdf",
            "id": "0b9c7a52-4f1e-4d38-9f43-2a5d6f1c8e70",
            "kind": "nccpa_certificate",
            "scan_status": "pending",
            "size_bytes": 482113
          }
        ],
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "file_name": {
            "title": "File Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
