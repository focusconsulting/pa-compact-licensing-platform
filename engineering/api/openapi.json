                {
                  "type": "null"
                }
              ],
              "title": "Entity Key"
            }
          },
          {
            "in": "query",
            "name": "actor_email",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Actor Email"
            }
          },
          {
            "in": "query",
            "name": "occurred_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
