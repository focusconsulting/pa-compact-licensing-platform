          "file_name",
          "content_type",
          "size_bytes",
          "kind",
          "scan_status",
          "created_at"
        ],
        "title": "DocumentOut",
        "type": "object"
      },
      "DocumentType": {
        "description": "The content types the bucket accepts.",
        "enum": [
          "application/pdf",
          "image/png",
          "image/jpeg",
          "text/csv",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ],
        "title": "DocumentType",
        "type": "string"
      },
      "DocumentUpload": {
        "description": "The new ``pending`` document and the form that uploads its file.",
        "examples": [
          {
            "document": {
              "content_type": "application/pdf",
              "created_at": "2026-11-05T15:04:05Z",
              "file_name": "nccpa-certificate.pdf",
              "id": "0b9c7a52-4f1e-4d38-9f43-2a5d6f1c8e70",
              "kind": "nccpa_certificate",
              "scan_status": "pending",
              "size_bytes": 482113
            },
            "upload": {
              "expires_at": "2026-11-05T15:04:05Z",
              "fields": {
                "Content-Type": "application/pdf",
                "key": "documents/0b9c7a52-4f1e-4d38-9f43-2a5d6f1c8e70"
              },
              "url": "https://example-documents.s3.amazonaws.com/"
            }
          }
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentOut"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadForm"
          }
        },
        "required": [
          "document",
          "upload"
        ],
        "title": "DocumentUpload",
        "type": "object"
      },
      "DocumentUploadIn": {
        "additionalProperties": false,
        "description": "The file the browser is about to upload. The bucket refuses any other size or type.",
        "examples": [
          {
            "content_type": "application/pdf",
            "file_name": "nccpa-certificate.pdf",
            "kind": "nccpa_certificate",
            "size_bytes": 482113
          }
        ],
        "properties": {
          "content_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "file_name": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$",
            "title": "File Name",
            "type": "string"
          },
          "kind": {
            "pattern": "^[a-z][a-z0-9_]{0,49}$",
            "title": "Kind",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 20971520.0,
            "minimum": 1.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "file_name",
          "content_type",
          "size_bytes",
          "kind"
        ],
        "title": "DocumentUploadIn",
        "type": "object"
      },
      "ErrorCode": {
        "description": "The machine-readable ``code`` in every error response.",
