      "PrivilegeComputedStatus": {
        "description": "What a privilege's holder and the public see (FLOW-06), in order of precedence.",
        "enum": [
          "inactive",
          "expired",
          "encumbered",
          "active"
        ],
        "title": "PrivilegeComputedStatus",
        "type": "string"
      },
      "PrivilegeRequestStatus": {
        "description": "A privilege request's states (FLOW-06).\n\n``withdrawn`` replaces FLOW-06's ``abandoned``: Rule 3 \u00a73.7(b)(1) says an\nincomplete request is \"deemed incomplete and to have been withdrawn\".",
        "enum": [
          "pending_payment",
          "submitted",
          "issued",
          "denied",
          "withdrawn"
        ],
        "title": "PrivilegeRequestStatus",
        "type": "string"
      },
      "ReadyResp": {
