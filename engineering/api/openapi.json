    "/api/me/documents": {
      "post": {
        "description": "Creates a `pending` document and returns a form, valid for five minutes, that uploads exactly `size_bytes` of `content_type` straight to storage. The file is scanned for malware before anyone can download it.",
        "operationId": "Upload_my_document_api_me_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Data_DocumentUpload_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload My Document",
        "tags": [
          "me"
        ]
      }
    },
