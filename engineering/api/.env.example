# Local service contract (epic 1, task 2xz.1)
#
# Every value below works for an API run on the host (`just dev`) against the
# local stack. Each external service is replaced locally by a mock server the
# app reaches through its production client; only the URL and credentials
# differ (constitution Principle IV). No setting here switches the app into
# fake behaviour, and none may be added that does.
#
# | Service            | Compose name      | Host port(s)          | Replaces in AWS        |
# |--------------------|-------------------|-----------------------|------------------------|
# | API                | api               | 8000                  | ECS service            |
# | Worker             | worker            | none                  | ECS service            |
# | Client             | client            | 3000                  | S3 + CloudFront        |
# | Postgres           | postgres          | 5432                  | Aurora PostgreSQL      |
# | Email              | maildev           | 1025 SMTP, 1080 web   | SES (SMTP interface)   |
# | File storage       | rustfs            | 9300 S3 API, 9301 web | S3                     |
# | Sign-in            | cognito-local     | 9229                  | Cognito                |
# | Payments mock      | authorizenet-mock | 8081                  | Authorize.net          |
# | Credentialing mock | nccpa-mock        | 8082                  | NCCPA API              |
#
# A container in the compose network uses the compose name and the service's
# own port instead, e.g. DB_HOST='postgres', S3_ENDPOINT_URL='http://rustfs:9000'.
# RustFS is published on 9300/9301 because Zscaler holds 9000 and 9010 on
# Focus laptops.

API_PORT='8000'

# can be 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL' see config.py
LOG_LEVEL='INFO'

# can be 'LOCAL_DEV', 'DEV', 'STAGING', 'PROD' see config.py
# Labels logs and traces only. It must not change behaviour; the seed-data
# gate in migrations.py that still reads it is removed by 2xz.3.
ENVIRONMENT='LOCAL_DEV'

# Comma-separated list of allowed CORS origins
CORS_ORIGINS='["http://localhost:3000"]'

# Postgres
DB_HOST='localhost'
DB_PORT='5432'
DB_NAME='licensing'
DB_USER='licensing'
DB_PASSWORD='secret123'

# Redis is unused and is removed by 2xz.2.
REDIS_URL='redis://localhost:6379'

# Sign-in: cognito-local locally, Cognito in AWS. Tokens are verified against
# {COGNITO_ENDPOINT_URL}/{COGNITO_USER_POOL_ID}/.well-known/jwks.json.
# In AWS: https://cognito-idp.{COGNITO_REGION}.amazonaws.com, and the pool and
# client IDs come from Terraform outputs. The local stack seeds a pool and
# client with these fixed IDs.
COGNITO_ENDPOINT_URL='http://localhost:9229'
COGNITO_REGION='us-east-1'
COGNITO_USER_POOL_ID='local_licensing'
COGNITO_CLIENT_ID='licensing-local-client'

# Email over SMTP: maildev locally (read mail at http://localhost:1080),
# SES's SMTP interface in AWS (email-smtp.us-east-1.amazonaws.com, port 587,
# STARTTLS, credentials from Secrets Manager).
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_STARTTLS='false'
SMTP_USERNAME=''
SMTP_PASSWORD=''
EMAIL_FROM_ADDRESS='no-reply@licensing.localhost'

# File storage over the S3 API: RustFS locally (console at
# http://localhost:9301), S3 in AWS. The keys are passed only to the S3
# client. In AWS the endpoint and keys are empty and the client uses the
# default endpoint and the task role.
S3_ENDPOINT_URL='http://localhost:9300'
S3_REGION='us-east-1'
S3_DOCUMENTS_BUCKET='documents'
S3_ACCESS_KEY_ID='rustfsadmin'
S3_SECRET_ACCESS_KEY='rustfsadmin'

# Payments: authorizenet-mock locally, Authorize.net in AWS
# (sandbox https://apitest.authorize.net/xml/v1/request.api, live
# https://api.authorize.net/xml/v1/request.api). The signature key verifies
# webhooks, which the mock posts to the local API.
AUTHORIZENET_API_URL='http://localhost:8081/xml/v1/request.api'
AUTHORIZENET_API_LOGIN_ID='local-login-id'
AUTHORIZENET_TRANSACTION_KEY='local-transaction-key'
AUTHORIZENET_SIGNATURE_KEY='local-signature-key'

# National credentialing: nccpa-mock locally and in test until the NCCPA
# contract is signed (Q-24), then the NCCPA API.
NCCPA_API_URL='http://localhost:8082'
NCCPA_API_KEY='local-nccpa-key'
