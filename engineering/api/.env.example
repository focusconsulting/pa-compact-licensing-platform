# Local deployments use high fidelity emulations of AWS and other services
#
# Usage:
#   cp .env.example .env
#
# Resolve local port collisions by changing ports to your preference in .env.
# docker compose uses the ports listed here.

API_PORT='8000'

# can be 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL' see config.py
LOG_LEVEL='INFO'

# LOCAL_DEV here; deployed containers get DEV, TEST, or PROD from the environment name in OpenTofu
ENVIRONMENT='LOCAL_DEV'

# Comma-separated list of allowed CORS origins
CORS_ORIGINS='["http://localhost:3000"]'

# Postgres
DB_HOST='localhost'
DB_PORT='5432'
DB_NAME='licensing'
DB_USER='licensing'
DB_PASSWORD='secret123'

# Sign-in: cognito-local locally, Cognito in AWS. Tokens are verified against
# {COGNITO_ENDPOINT_URL}/{COGNITO_USER_POOL_ID}/.well-known/jwks.json.
# In AWS: https://cognito-idp.{COGNITO_REGION}.amazonaws.com, and the pool and
# client IDs come from Terraform outputs. The local stack seeds a pool and
# client with these fixed IDs.
COGNITO_HOST='localhost'
COGNITO_PORT='9229'
COGNITO_ENDPOINT_URL="http://${COGNITO_HOST}:${COGNITO_PORT}"
COGNITO_REGION='us-east-1'
COGNITO_USER_POOL_ID='local_licensing'
COGNITO_CLIENT_ID='licensing-local-client'

# Email over SMTP: maildev locally (read mail on MAILDEV_UI_PORT), SES's
# SMTP interface in AWS (email-smtp.us-east-1.amazonaws.com, port 587,
# STARTTLS, credentials from Secrets Manager).
SMTP_HOST='localhost'
SMTP_PORT='1025'
MAILDEV_UI_PORT='1080'
SMTP_STARTTLS='false'
SMTP_USERNAME=''
SMTP_PASSWORD=''
EMAIL_FROM_ADDRESS='no-reply@licensing.localhost'

# Links in emails point here: the client's origin.
CLIENT_BASE_URL='http://localhost:3000'

# The Commission mailbox for operational notifications (decisions, issued
# privileges, adverse actions); empty sends none.
COMMISSION_OPS_EMAIL='commission-ops@licensing.localhost'

# File storage over the S3 API: RustFS locally (console on S3_CONSOLE_PORT),
# S3 in AWS. In AWS the endpoint and keys are unset and the client uses S3's
# own endpoint and the task role. Locally the S3 client reads RustFS's keys
# from the standard AWS variables below (ADR-0017); only the API's own
# processes read this file.
S3_HOST='localhost'
S3_PORT='9300'
S3_CONSOLE_PORT='9301'
S3_ENDPOINT_URL="http://${S3_HOST}:${S3_PORT}"
S3_REGION='us-east-1'
S3_DOCUMENTS_BUCKET='documents'
AWS_ACCESS_KEY_ID='rustfsadmin'
AWS_SECRET_ACCESS_KEY='rustfsadmin'

# NCCPA's Board Certification Status API (engineering/docs/nccpa.md):
# nccpa-mock locally and in CI. NCCPA issues the client ID and secret.
NCCPA_HOST='localhost'
NCCPA_PORT='8082'
NCCPA_API_URL="http://${NCCPA_HOST}:${NCCPA_PORT}"
NCCPA_CLIENT_ID='local-nccpa-client'
NCCPA_CLIENT_SECRET='local-nccpa-secret'

# FSMB's Physician Data Center (engineering/docs/fsmb.md): fsmb-mock locally,
# FSMB's demo server in staging, production in prod. In AWS the client ID and
# secret come from Secrets Manager.
FSMB_HOST='localhost'
FSMB_PORT='8083'
FSMB_API_URL="http://${FSMB_HOST}:${FSMB_PORT}"
FSMB_CLIENT_ID='local-fsmb-client'
FSMB_CLIENT_SECRET='local-fsmb-secret'
FSMB_CUSTOMER_KEY='me'
