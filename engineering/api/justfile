# Default recipe: show available commands
default:
    @just --list

app_name := "pa-compact-api"
image_tag := if `git rev-parse --is-inside-work-tree 2>/dev/null || true` == "true" { `git rev-parse HEAD` } else { "unknown-dev." + `date -u '+%Y%m%d.%H%M%S'` }
open_cmd := if os() == "macos" { "open" } else { "xdg-open" }

# Install dependencies
install:
    uv sync

# Start the local services (Postgres, maildev, RustFS, Cognito mock), resetting their data
infra: infra-down
    docker compose -p pa-compact up -d --wait --build
    docker compose -p pa-compact wait rustfs-init >/dev/null

# Stop local infrastructure containers
infra-down:
    docker compose -p pa-compact down -v

# Apply database migrations without starting the API
migrate env-file=".env":
    uv run --env-file {{ env-file }} python -c 'from licensing_api.migrations import run_migrations; run_migrations()'

# Load local seed data from seed/<name>.py, or else seed/<name>.sql, into the running Postgres (local only)
seed name="users" env-file=".env":
    if [ -f seed/{{ name }}.py ]; then \
        uv run --env-file {{ env-file }} python -m seed.{{ name }}; \
    else \
        docker compose -p pa-compact exec -T postgres psql -v ON_ERROR_STOP=1 -U licensing -d licensing < seed/{{ name }}.sql; \
    fi

# Write openapi.json from the code; the client's `pnpm generate` reads it
openapi:
    uv run python -m scripts.export_openapi

# Run the API with hot reload. Override env file with: just dev env-file=.env.dev
dev env-file=".env":
    uv run uvicorn licensing_api.__main__:app --reload --env-file {{ env-file }}

# Run the Worker, restarting it when the code changes. Override env file with: just worker env-file=.env.dev
worker env-file=".env":
    uv run --env-file {{ env-file }} watchfiles --filter python 'python -m licensing_api.worker' licensing_api

# Run one scheduled job once, as EventBridge does in AWS (`just job heartbeat`)
job name env-file=".env":
    uv run --env-file {{ env-file }} python -m licensing_api.jobs run {{ name }}

# Send every email template, or those named, with sample data to maildev (`just email-preview welcome --to me@example.com`)
email-preview *args:
    uv run --env-file .env python -m licensing_api.notifications.preview {{ args }}

# Run tests (pass additional args with: just test -k test_name)
test env-file=".env" *args:
    uv run --env-file {{ env-file }} pytest {{ args }}

# Run tests with coverage report
test-coverage env-file=".env" *args:
    uv run --env-file {{ env-file }} coverage run -m pytest {{ args }}
    uv run coverage report

# Open HTML coverage report in browser
test-coverage-report:
    uv run coverage html --directory .coverage_report
    {{ open_cmd }} .coverage_report/index.html

# Everything CI checks: lint (ruff, docstrings, pyright) and tests at 100% coverage
check: lint test-coverage

# Run all linting (ruff + pyright)
lint: lint-ruff typecheck

# Run ruff linter and format check
lint-ruff:
    uv run ruff check licensing_api tests
    uv run ruff format --check licensing_api tests

# Run pyright type checker
typecheck:
    uv run pyright licensing_api seed

# Format code with ruff
format:
    uv run ruff check --fix licensing_api tests
    uv run ruff format licensing_api tests

# Build the production image for Fargate (linux/amd64), tagged with the commit
build:
    docker build --platform linux/amd64 --target app \
        --tag {{ app_name }}:latest \
        --tag {{ app_name }}:{{ image_tag }} .

# Push the built image to an ECR repository URL; a tag already there is left alone (tags are immutable)
push $repo: build
    aws ecr get-login-password | docker login --username AWS --password-stdin "${repo%%/*}"
    if aws ecr describe-images --repository-name "${repo##*/}" --image-ids imageTag={{ image_tag }} >/dev/null 2>&1; then \
        echo "{{ image_tag }} is already in $repo"; \
    else \
        docker tag {{ app_name }}:{{ image_tag }} "$repo:{{ image_tag }}" && docker push "$repo:{{ image_tag }}"; \
    fi
