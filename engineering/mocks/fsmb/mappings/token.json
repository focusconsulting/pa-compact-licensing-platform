{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/connect/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "formParameters": {
      "grant_type": {
        "equalTo": "client_credentials"
      },
      "client_id": {
        "equalTo": "local-fsmb-client"
      },
      "client_secret": {
        "equalTo": "local-fsmb-secret"
      },
      "scope": {
        "contains": "pdc.member_read"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "local-fsmb-token",
      "expires_in": 3600,
      "token_type": "Bearer",
      "scope": "pdc.member_read"
    }
  }
}
