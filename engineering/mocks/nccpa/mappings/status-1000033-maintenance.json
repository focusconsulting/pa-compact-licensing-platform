{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/CertificationStatus",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer local-nccpa-token"
      },
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.id",
          "equalTo": "1000033"
        }
      }
    ]
  },
  "response": {
    "status": 503
  }
}
