{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "formParameters": {
      "grant_type": {
        "equalTo": "client_credentials"
      },
      "client_id": {
        "equalTo": "local-nccpa-client"
      },
      "client_secret": {
        "equalTo": "local-nccpa-secret"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json;charset=UTF-8"
    },
    "jsonBody": {
      "access_token": "local-nccpa-token",
      "token_type": "bearer",
      "expires_in": 3599,
      ".issued": "Thu, 12 Nov 2026 17:00:00 GMT",
      ".expires": "Thu, 12 Nov 2026 18:00:00 GMT"
    }
  }
}
