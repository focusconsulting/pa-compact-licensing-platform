{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/CertificationStatus",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer local-nccpa-token"
      },
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.id",
          "equalTo": "1000020"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "paId": 1000020,
      "firstName": "Dana",
      "lastName": "Datesless",
      "certificationStatus": "Certified",
      "expirationDate": null,
      "certificationDate": null
    }
  }
}
