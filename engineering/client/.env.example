# Non-secret settings only: NEXT_PUBLIC_* values are baked into the static
# export at build time and shipped to every browser.
#
# Values work against the local stack; see engineering/api/.env.example for
# the full list of local services and ports. As in the API, each external
# service is reached by URL and no setting switches in fake behaviour
# (constitution Principle IV).
NEXT_PUBLIC_BASE_PATH=

# The local API (`just dev`)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sign-in: cognito-local locally. In AWS leave the endpoint empty so the SDK
# uses Cognito, and take the pool and client IDs from Terraform outputs.
NEXT_PUBLIC_COGNITO_ENDPOINT_URL=http://localhost:9229
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=local_licensing
NEXT_PUBLIC_COGNITO_CLIENT_ID=licensing-local-client

# Payments: Accept.js from authorizenet-mock locally. In AWS
# https://jstest.authorize.net/v1/Accept.js (sandbox) or
# https://js.authorize.net/v1/Accept.js (live), with the public client key.
NEXT_PUBLIC_AUTHORIZENET_ACCEPT_JS_URL=http://localhost:8081/v1/Accept.js
NEXT_PUBLIC_AUTHORIZENET_API_LOGIN_ID=local-login-id
NEXT_PUBLIC_AUTHORIZENET_CLIENT_KEY=local-client-key
