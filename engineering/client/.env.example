# Non-secret settings only: NEXT_PUBLIC_* values are baked into the static
# export at build time and shipped to every browser.
#
#
# Usage
#    cp .env.example .env
#
# Adjust ports as necessary to align with API (../api/.env)

NEXT_PUBLIC_BASE_PATH=

# The local API (`just dev` from ../api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sign-in: cognito-local locally. In AWS leave the endpoint and auth flow empty
# so the SDK uses Cognito with SRP, and take the pool and client IDs from
# Terraform outputs. cognito-local has no SRP (ADR-0010).
COGNITO_HOST=localhost
COGNITO_PORT=9229
NEXT_PUBLIC_COGNITO_ENDPOINT_URL="http://${COGNITO_HOST}:${COGNITO_PORT}"
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=local_licensing
NEXT_PUBLIC_COGNITO_CLIENT_ID=licensing-local-client
NEXT_PUBLIC_COGNITO_AUTH_FLOW=USER_PASSWORD_AUTH
