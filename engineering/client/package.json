{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-uswds-assets": "cp -r node_modules/@uswds/uswds/dist/fonts public/uswds/fonts && cp -r node_modules/@uswds/uswds/dist/img public/uswds/img",
    "postinstall": "mkdir -p public/uswds && pnpm run copy-uswds-assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0 && stylelint \"src/**/*.scss\" --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts && prettier --write src/api",
    "format": "prettier --write . && eslint \"src/**/*.{ts,tsx}\" --fix && stylelint \"src/**/*.scss\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "a11y": "scripts/a11y.sh"
  },
  "dependencies": {
    "@trussworks/react-uswds": "^13.0.0",
    "@uswds/uswds": "^3.14.0",
    "amazon-cognito-identity-js": "^6.3.22",
    "i18next": "^26.5.11",
    "next": "^16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@storybook/addon-links": "^10.6.4",
    "@storybook/addon-onboarding": "^10.6.4",
    "@storybook/nextjs": "^10.6.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-storybook": "^10.6.4",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "pa11y-ci": "^5.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "serve": "^14.2.6",
    "storybook": "^10.6.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
